ENVIRONMENT=development
DEMO_MODE=true
# Compose default: sqlite:////data/geo_sentinel.db on shared sqlite_data volume.
# Local default: sqlite:///./geo_sentinel.db (anchored at backened/, CWD-independent).
DATABASE_URL=sqlite:///./geo_sentinel.db   # production: postgresql+psycopg2://USER:PASS@postgres/geosentinel
# (No REDIS_URL — Redis is explicitly out of scope. No JWT_SECRET — JWT is roadmap, not implemented.)
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=geosentinel
# Fusion weights: single source of truth is backened/risk_thresholds.yaml
# (static 0.4 / dynamic 0.6). Uncomment ONLY to override deliberately.
#STATIC_WEIGHT=0.4
#DYNAMIC_WEIGHT=0.6

# External providers (all optional in demo mode)
IMD_API_BASE_URL=
IMD_API_KEY=
NASA_API_KEY=
SENTINEL_API_BASE_URL=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
# NER pipeline auth (never commit values; AUTH_REQUIRED without them)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Phase-2 live path (keyless): RAIN_PROVIDER=openmeteo for LIVE rainfall +
# modeled soil moisture (UNVERIFIED until first successful run); default mock.
RAIN_PROVIDER=mock
WEATHER_PROVIDER=mock       # mock | openmeteo | imd (imd needs IMD_API_BASE)
SOIL_PROVIDER=modeled       # demo | modeled | smap | sensor
SATELLITE_PROVIDER=demo     # demo | sentinel1 (needs SATELLITE_LIVE=true + creds)
PUSH_PROVIDER=mock          # mock | fcm (needs FCM_SERVER_KEY)
OPENMETEO_TIMEOUT_S=15
OPENMETEO_CACHE_S=600
SATELLITE_LIVE=false
MAMBA_LIVE=false
MAMBA_WEIGHTS=
ALERT_COOLDOWN_MIN=360
WORKER_INTERVAL_MIN=15
ADMIN_API_KEY=               # production: REQUIRED (auth fails closed without keys when ENVIRONMENT=production)
CORS_ORIGINS=*               # development default; production: REQUIRED explicit origins (ENVIRONMENT=production + "*" serves no origins)

SMS_PROVIDER=mock            # mock | twilio | msg91
SMS_API_KEY=
SMS_AUTH_TOKEN=
SMS_SENDER_ID=GEOSENTRY

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=geo-sentinel-media  # demo: local ./media directory
