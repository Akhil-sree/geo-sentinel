# Environment files and credentials (keep only blank examples)
.env
.env.*
!.env.example
backened/.env
backened/.env.*
!backened/.env.example

# Local databases and generated uploads
*.db
*.sqlite
*.sqlite3
backened/media/
uploads/

# Local runtimes and build outputs
node_modules/
frontend/node_modules/
frontend/public/cesium/
backened/.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
dist/
build/
coverage/

# Logs, editor settings, and OS files
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# NER pipeline: large raw downloads + manual drops stay local.
# (Already-committed small artifacts remain tracked; this covers new bulk.)
backened/data/raw/*.pbf
backened/data/raw/*.h5
backened/data/raw/*.hdf5
backened/data/raw/*.nc
backened/data/raw/*.tif
backened/data/raw/*.zip
backened/data/raw/coolr_*.json
backened/data/raw/ner_rain_*.json
backened/data/raw/ner_dem_*.json
backened/data/raw/ner_sar_*.json
backened/data/raw/osm_zone_*.json
backened/data/manual/
backened/models/ner_*/

# GEO-SENTINEL: raw datasets, generated pipeline outputs, experiment run
# history, and model binaries stay local — never commit. Lightweight
# metadata (registry/metrics/metadata/config JSON, docs) is committed.
datasets/
backened/data/raw/
backened/data/processed/
experiments/
*.tif
*.tiff
*.pbf
*.zip
*.nc
*.h5
*.hdf5
*.pt
*.joblib
*.npy
*.npz
*.parquet
.venv/
.ruff_cache/
