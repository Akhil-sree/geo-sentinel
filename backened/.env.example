# GEO-SENTINEL demo defaults — every live integration is opt-in and labeled.
ENVIRONMENT=development
DEMO_MODE=true
# Demo default: relative sqlite resolves against the backend dir (see
# app/database.py). In compose, backend+worker share sqlite_data:/data with
# DATABASE_URL=sqlite:////data/geo_sentinel.db (same file, no split-brain).
DATABASE_URL=sqlite:///./geo_sentinel.db
SMS_PROVIDER=mock            # mock | twilio | msg91 (live needs creds below)
EMAIL_PROVIDER=mock          # mock | smtp
RAIN_PROVIDER=mock           # mock | openmeteo (keyless, verified 2026-09-14)
OPENMETEO_TIMEOUT_S=15
OPENMETEO_CACHE_S=600
SATELLITE_LIVE=false         # no live path without COPERNICUS_USER
SATELLITE_PROVIDER=demo     # demo | sentinel1 (sentinel1 needs SATELLITE_LIVE=true + COPERNICUS_USER)
WEATHER_PROVIDER=mock       # mock | openmeteo | imd (imd needs IMD_API_BASE; openmeteo keyless)
SOIL_PROVIDER=modeled       # demo | modeled | smap | sensor (sensor = POST /api/sensors/*)
PUSH_PROVIDER=mock          # mock | fcm (fcm needs FCM_SERVER_KEY)
FCM_SERVER_KEY=
FCM_API_URL=https://fcm.googleapis.com/fcm/send
MAMBA_LIVE=false             # needs MAMBA_WEIGHTS checkpoint + metrics gate
MAMBA_WEIGHTS=
ALERT_COOLDOWN_MIN=360
WORKER_INTERVAL_MIN=15
# Auth: open-demo when empty. Roles: API_KEYS="key1:admin,key2:operator,key3:viewer"
ADMIN_API_KEY=
API_KEYS=
CORS_ORIGINS=*
# Secrets: ENC: values decrypt via FERNET_KEY (never commit plaintext)
FERNET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Legacy/roadmap provider keys (no live path yet — roadmap, not claims)
IMD_API_BASE=
IMD_API_KEY=
COPERNICUS_USER=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_API_KEY=
MSG91_SENDER_ID=
# Routing: max snap distance (m) from request point to road graph — beyond
# this, rescue/routing answers OUT_OF_COVERAGE instead of a route.
ROUTE_MAX_SNAP_DISTANCE_M=5000
# Reverse-proxy trust: X-Forwarded-For is honoured for rate-limit client-IP
# ONLY from these direct-peer IPs (your nginx/LB). Default empty = never
# trust forwarded headers (spoof-safe). Compose nginx: TRUSTED_PROXIES=<lb ip>
TRUSTED_PROXIES=
# Prod profile: DATABASE_URL=postgresql+psycopg2://geosentinel:geosentinel@postgres/geosentinel
