# Copy to .env and adjust. All variables are optional; defaults target the
# standard setups (vite dev proxy, docker compose nginx).
#
# Backend API base URL consumed by src/api/client.ts:
# - default (unset): same-origin "/api" — works with `npm run dev` (vite
#   proxy -> localhost:8000) and with docker compose (nginx -> backend:8000).
# - direct backend (no proxy): full URL + /api path, e.g.
#   VITE_API_BASE_URL=https://geo-sentinel-api.example.com/api
# NOTE: VITE_* values are baked in at BUILD time (`npm run build`).
#   Rebuild (or use the nginx /api proxy) when the backend URL changes.
VITE_API_BASE_URL=/api

# Basemap tile URL template ({s}/{z}/{x}/{y} Leaflet placeholders).
# Default: Esri World Imagery (requires network; attribution required —
# see https://www.esri.com/en-us/legal/terms/full-master-agreement).
# Any XYZ tile source works, e.g. OpenStreetMap standard:
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# On tile failure the map auto-falls-back to OSM standard and shows a
# BASEMAP UNAVAILABLE chip instead of breaking the app. There is no offline
# tile bundle — offline mode covers field-report queueing only.
VITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
